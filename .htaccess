# Apache Configuration for NUTRONYX
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect old manifesto-nature.jpg requests to manifesto-nature.png
    RewriteRule ^assets/images/manifesto-nature\.jpg$ assets/images/manifesto-nature.png [R=301,L]

    # Allow clean, extensionless URLs (e.g., /admin/login -> /admin/login.php, /shop -> /shop.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# MultiViews fallback for Apache extensionless file negotiation
<IfModule mod_negotiation.c>
    Options +MultiViews
</IfModule>

# Force UTF-8 Encoding
AddDefaultCharset UTF-8

# Prevent Directory Browsing
Options -Indexes

# Cache Management for Fast Updates & CDN Freshness
<IfModule mod_headers.c>
    # Dynamic PHP Pages: Never cache in browser or proxy
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Versioned CSS & JS: Revalidate to avoid stale styles
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Manifesto Image Freshness: Ensure clients revalidate
    <FilesMatch "manifesto-nature\.(png|jpg)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
