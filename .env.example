# Nutronyx Commerce & Logistics Environment Configuration

# Multi-Tenant Website Binding (Leave empty for multi-store SaaS, or set to isolate to one website)
# When set, the store dropdown is hidden and all queries are locked to this store.
# TENANT_WEBSITE_ID=web_nutronyx_d2c

# Ekart Logistics Enterprise Gateway (Flipkart Logistics)
# Obtain these credentials from your Ekart Elite Merchant Console: https://app.elite.ekartlogistics.in
EKART_CLIENT_ID=your_ekart_client_id_here
EKART_USERNAME=your_ekart_api_username_or_email
EKART_PASSWORD=your_ekart_api_secret_password
EKART_ENVIRONMENT=PRODUCTION